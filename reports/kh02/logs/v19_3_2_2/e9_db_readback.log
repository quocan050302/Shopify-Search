    const { PrismaClient } = require('@prisma/client');
    const prisma = new PrismaClient();
    async function check() {
      const uahpetId = 'cmvsy7zqh000jp0orhypwohho';
      const obs = await prisma.productDemandObservation.findMany({
        where: { productId: uahpetId },
        orderBy: { periodStart: 'asc' }
      });
      console.log('Database readback for UAHPET canonical ID:', uahpetId);
      console.log('Total demand observations:', obs.length);
      console.log('Distinct keywords:', Array.from(new Set(obs.map(o => o.keyword))));
      console.log('Sources:', Array.from(new Set(obs.map(o => o.source))));
      console.log('Evidence references:', Array.from(new Set(obs.map(o => o.evidenceReference))));
      await prisma.\$disconnect();
    }
    check().catch(e => { console.error(e); process.exit(1); });
  "
