// Prisma Schema for Shopify Winning Ads Intelligence (SWAI)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -------------------------------------------------------------
// Authentication & Multi-Tenant Workspaces
// -------------------------------------------------------------
model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  role         String            @default("RESEARCHER") // ADMIN, RESEARCHER, VIEWER
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  workspaces   WorkspaceMember[]
  notes        ResearchNote[]
  watchlists   Watchlist[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String               @default("Default Research Workspace")
  operatingMode       String               @default("RESEARCH_ONLY") // RESEARCH_ONLY, RESEARCH_AND_STORE, OWNED_AD_ACCOUNT_ANALYTICS
  targetMarket        String               @default("US")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             WorkspaceMember[]
  connections         ProviderConnection[]
  watchlists          Watchlist[]
  savedSearches       SavedSearch[]
  syncJobs            SyncJob[]
  connectedShops      ConnectedShop[]
  advertisingAccounts AdvertisingAccount[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// -------------------------------------------------------------
// Provider Management & Capabilities
// -------------------------------------------------------------
model DataSource {
  id             String               @id @default(cuid())
  name           String               @unique // META_AD_LIBRARY, TIKTOK_CREATIVE_CENTER, USER_OBSERVED, WEB_SCRAPER
  displayName    String
  description    String?
  status         String               @default("AVAILABLE") // AVAILABLE, CONNECTED, REQUIRES_AUTH, REQUIRES_LICENSE, UNSUPPORTED_REGION, UNAVAILABLE
  capabilities   String               // JSON array of strings
  supportedRegions String             // JSON array e.g. ["US", "CA", "UK"]
  rateLimitInfo  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  connections    ProviderConnection[]
  ads            CompetitorAd[]

  @@map("data_sources")
}

model ProviderConnection {
  id           String      @id @default(cuid())
  workspaceId  String
  dataSourceId String
  status       String      @default("NOT_CONNECTED") // CONNECTED, NOT_CONNECTED, ERROR, EXPIRED
  authDetails  String?     // Encrypted or redacted token info
  lastTestedAt DateTime?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource   DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dataSourceId])
  @@map("provider_connections")
}

// -------------------------------------------------------------
// Competitor Research Core (Ads, Media, Observations)
// -------------------------------------------------------------
model Advertiser {
  id               String          @id @default(cuid())
  externalId       String?         @unique // Meta page ID or TikTok advertiser ID
  platform         String          // META, TIKTOK, OTHER
  name             String
  profileUrl       String?
  avatarUrl        String?
  domain           String?
  country          String?         @default("US")
  verifiedStatus   String          @default("OBSERVED") // VERIFIED, OBSERVED, ESTIMATED, UNAVAILABLE
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ads              CompetitorAd[]
  stores           CompetitorStore[]

  @@index([platform, name])
  @@map("advertisers")
}

model CompetitorAd {
  id               String               @id @default(cuid())
  advertiserId     String
  dataSourceId     String
  externalAdId     String?              @unique
  platform         String               // META, TIKTOK
  targetMarket     String               @default("UNKNOWN") // V7: was US, now UNKNOWN to avoid false market attribution
  headline         String?
  bodyText         String?
  callToAction     String?
  landingPageUrl   String?
  originalAdUrl    String               // Canonical source link
  firstSeenAt      DateTime             @default(now())
  lastSeenAt       DateTime             @default(now())
  daysRunning      Int                  @default(1)    // Legacy: use calendarAgeDays from longevity engine instead
  status           String               @default("UNKNOWN") // V7: UNKNOWN|ACTIVE_VERIFIED|INACTIVE_VERIFIED|NOT_OBSERVED_RECENTLY|SOURCE_UNAVAILABLE|ARCHIVED|SYNTHETIC_QUARANTINED
  lifecycleStatus  String               @default("UNKNOWN") // V7: explicit lifecycle state
  category         String               @default("Other")
  dataConfidence   String               @default("UNVERIFIED") // V7: was OBSERVED, now UNVERIFIED for new imports
  // V7 lifecycle fields (all nullable — provider data may not supply these)
  sourceReportedStartAt  DateTime?      // Date the provider reported the ad started
  sourceReportedEndAt    DateTime?      // Date the provider reported the ad stopped
  lastVerifiedActiveAt   DateTime?      // Last time ACTIVE status was positively confirmed
  lastVerifiedInactiveAt DateTime?      // Last time INACTIVE status was positively confirmed
  firstObservedAt        DateTime?      // When SWAI first saw this ad
  lastObservedAt         DateTime?      // Most recent SWAI observation
  longevityCategory      String?        // NEW_TESTING|EARLY_POTENTIAL|PROMISING|STRONG_CANDIDATE|EVERGREEN_CANDIDATE|LONG_TERM_REFERENCE
  observationCount       Int            @default(0)  // Count of SWAI observations
  verifiedActiveCount    Int            @default(0)  // Subset of observations with confirmed active status
  isSyntheticQuarantine  Boolean        @default(false) // V7: explicit quarantine flag
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  advertiser       Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  dataSource       DataSource           @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  mediaAssets      AdMediaAsset[]
  observations     AdObservation[]
  lifecycleEvents  AdLifecycleEvent[]
  metricObservations AdMetricObservation[]
  productLinks     AdProductLink[]
  creativeVariants ProductCreativeVariant[]
  analyses         CreativeAnalysis[]
  researchScores   ResearchScore[]
  evergreenScores  EvergreenScore[]
  watchlistItems   WatchlistItem[]
  notes            ResearchNote[]
  researchDecisions ResearchDecision[]
  sourceIdentities AdSourceIdentity[]

  @@index([platform, status])
  @@index([platform, lifecycleStatus])
  @@index([category])
  @@index([firstSeenAt])
  @@index([longevityCategory])
  @@map("competitor_ads")
}

model AdMediaAsset {
  id              String        @id @default(cuid())
  adId            String
  mediaType       String        @default("VIDEO") // VIDEO, IMAGE, CAROUSEL
  videoUrl        String?       // Direct mp4 if authorized
  embedUrl        String?       // Official authorized embed iframe URL
  thumbnailUrl    String?
  aspectRatio     String?       @default("9:16") // 9:16, 1:1, 16:9
  durationSeconds Float?
  width           Int?
  height          Int?
  availability    String        @default("READY") // READY, EXPIRED, RESTRICTED, FALLBACK_ONLY
  source          String        @default("OFFICIAL_EMBED")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ad              CompetitorAd  @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@map("ad_media_assets")
}

model AdObservation {
  id                String        @id @default(cuid())
  adId              String
  observedAt        DateTime      @default(now())
  // V7: replaced isActive Boolean with observationStatus string
  observationStatus String        @default("UNKNOWN") // ACTIVE|INACTIVE|UNKNOWN|CHECK_FAILED|ACCESS_RESTRICTED
  isActive          Boolean?      // Deprecated — kept for migration safety
  evidenceType      String        @default("USER_OBSERVED") // API_SYNC|USER_OBSERVED|URL_CHECK|MANUAL_ENTRY
  verificationMethod String?      // HEAD_CHECK|SOURCE_PAGE_LOADED|AD_METADATA_VERIFIED|ACTIVE_STATUS_VERIFIED
  evidenceReference String?       // URL or payload reference supporting this observation
  sourceTimestamp   DateTime?     // Timestamp from the source provider (if any)
  confidence        Float?        // 0.0–1.0 confidence in this observation
  rawPayload        String?
  ad                CompetitorAd  @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, observedAt])
  @@index([adId, observationStatus])
  @@map("ad_observations")
}

model AdMetricObservation {
  id             String        @id @default(cuid())
  adId           String
  metricKey      String        // IMPRESSIONS_RANGE, LIKES, COMMENTS, SHARES, SPEND_RANGE
  metricValue    Float?
  textValue      String?       // e.g. "< 10k", "10k - 50k"
  classification String        @default("OBSERVED") // VERIFIED, OBSERVED, ESTIMATED, UNAVAILABLE
  observedAt     DateTime      @default(now())
  ad             CompetitorAd  @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, metricKey])
  @@map("ad_metric_observations")
}

// -------------------------------------------------------------
// Product Research & Store Detection
// -------------------------------------------------------------
model CompetitorStore {
  id                String            @id @default(cuid())
  advertiserId      String?
  domain            String            @unique // e.g. pureglow.com
  storeName         String?
  commercePlatform  String            @default("UNKNOWN") // SHOPIFY_CONFIRMED, SHOPIFY_POSSIBLE, OTHER, UNKNOWN
  currency          String            @default("USD")
  country           String?           @default("US")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  advertiser        Advertiser?       @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  products          ResearchProduct[]

  @@map("competitor_stores")
}

model ResearchProduct {
  id               String                 @id @default(cuid())
  storeId          String?
  title            String
  category         String                 @default("Other")
  description      String?
  imageUrl         String?
  currentPrice     Float?
  currency         String                 @default("USD")
  productUrl       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  store            CompetitorStore?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  adLinks          AdProductLink[]
  priceHistory     ProductPriceObservation[]
  watchlistItems   WatchlistItem[]
  notes            ResearchNote[]
  demandObservations ProductDemandObservation[]
  evergreenScores    EvergreenProductScore[]
  researchDecisions  ResearchDecision[]

  @@index([category])
  @@map("research_products")
}

model ProductPriceObservation {
  id         String          @id @default(cuid())
  productId  String
  price      Float
  currency   String          @default("USD")
  observedAt DateTime        @default(now())
  source     String          @default("STOREFRONT_HTTP")
  product    ResearchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, observedAt])
  @@map("product_price_observations")
}

model AdProductLink {
  id         String          @id @default(cuid())
  adId       String
  productId  String
  confidence String          @default("HIGH_CONFIDENCE") // CONFIRMED, HIGH_CONFIDENCE, PROBABLE
  createdAt  DateTime        @default(now())
  ad         CompetitorAd    @relation(fields: [adId], references: [id], onDelete: Cascade)
  product    ResearchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([adId, productId])
  @@map("ad_product_links")
}

// -------------------------------------------------------------
// AI Creative Intelligence & Winning Potential Score
// -------------------------------------------------------------
model CreativeAnalysis {
  id                 String       @id @default(cuid())
  adId               String
  modelVersion       String       @default("gemini-1.5-pro")
  hookType           String       // Problem-First, Curiosity, Surprise, Demonstration, UGC, Transformation, Emotional
  hookQualityScore   Float        // 0-100
  pacingScore        Float        // 0-100
  ctaClassification  String       // SHOP_NOW, LEARN_MORE, DISCOUNT, FREE_SHIPPING
  sellingPoints      String       // JSON array of strings
  weaknesses         String       // JSON array of strings
  scriptIdeas        String?      // JSON or text of original 15s/30s ad concepts
  rawAnalysis        String?
  createdAt          DateTime     @default(now())
  ad                 CompetitorAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@map("creative_analyses")
}

model ResearchScore {
  id                 String       @id @default(cuid())
  adId               String
  totalScore         Float        // 0-100
  tier               String       // HIGH_POTENTIAL, MEDIUM_POTENTIAL, LOW_POTENTIAL, INSUFFICIENT_EVIDENCE
  longevityScore     Float
  diversityScore     Float
  performanceScore   Float
  recencyScore       Float
  clarityScore       Float
  aiQualityScore     Float
  confidenceScore    Float        // 0-100
  formulaVersion     String       @default("1.0.0")
  scoreBreakdown     String       // JSON details
  createdAt          DateTime     @default(now())
  ad                 CompetitorAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
  @@index([totalScore])
  @@map("research_scores")
}

// -------------------------------------------------------------
// Watchlists, Saved Searches & Research Notes
// -------------------------------------------------------------
model Watchlist {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String?
  name        String
  description String?
  isPinned    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id         String           @id @default(cuid())
  watchlistId String
  itemType   String           // AD, PRODUCT
  adId       String?
  productId  String?
  addedAt    DateTime         @default(now())
  watchlist  Watchlist        @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  ad         CompetitorAd?    @relation(fields: [adId], references: [id], onDelete: Cascade)
  product    ResearchProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, itemType, adId, productId])
  @@map("watchlist_items")
}

model SavedSearch {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  filtersJson String    // JSON of search criteria
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

model ResearchNote {
  id        String           @id @default(cuid())
  userId    String?
  adId      String?
  productId String?
  title     String?
  content   String
  tags      String?          // Comma-separated tags
  priority  String           @default("MEDIUM") // HIGH, MEDIUM, LOW
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  ad        CompetitorAd?    @relation(fields: [adId], references: [id], onDelete: Cascade)
  product   ResearchProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("research_notes")
}

// -------------------------------------------------------------
// Automation, Jobs & Provenance Audit
// -------------------------------------------------------------
model SyncJob {
  id          String    @id @default(cuid())
  workspaceId String
  jobType     String    // AD_IMPORT, SOURCE_REFRESH, SCORE_RECOMPUTE, REPORT_GEN
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIALLY_COMPLETED, FAILED
  progress    Int       @default(0)
  totalItems  Int       @default(0)
  resultJson  String?
  errorMessage String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // AD_IMPORTED, NOTE_ADDED, SCORE_CALCULATED, SETTING_CHANGED
  entityType String
  entityId   String
  detailsJson String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// -------------------------------------------------------------
// Future Commerce Architecture (Prepared Schema, Inactive)
// -------------------------------------------------------------
model ConnectedShop {
  id          String    @id @default(cuid())
  workspaceId String
  shopDomain  String    @unique
  status      String    @default("NOT_CONNECTED") // CONNECTED, NOT_CONNECTED, DISCONNECTED
  accessToken String?   // Encrypted
  scopes      String?
  installedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("connected_shops")
}

model AdvertisingAccount {
  id           String    @id @default(cuid())
  workspaceId  String
  platform     String    // META_ADS, TIKTOK_ADS
  accountId    String
  accountName  String?
  currency     String    @default("USD")
  status       String    @default("NOT_CONNECTED")
  accessToken  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountId])
  @@map("advertising_accounts")
}

// -------------------------------------------------------------
// V7 — Evergreen Intelligence Models
// -------------------------------------------------------------

/// Lifecycle events for an advertisement (ordered timeline)
model AdLifecycleEvent {
  id                String       @id @default(cuid())
  adId              String
  eventType         String       // AD_DISCOVERED|SOURCE_START_DATE_OBSERVED|ACTIVE_VERIFIED|INACTIVE_VERIFIED|SOURCE_ACCESS_LOST|CREATIVE_VARIANT_DISCOVERED|PRODUCT_ASSOCIATION_CONFIRMED
  occurredAt        DateTime     @default(now())
  sourceTimestamp   DateTime?    // Provider-reported timestamp (if different from occurredAt)
  evidenceReference String?      // URL or source backing this event
  confidence        Float?       // 0.0–1.0
  notes             String?
  createdAt         DateTime     @default(now())
  ad                CompetitorAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, occurredAt])
  @@map("ad_lifecycle_events")
}

/// V7 Evergreen Score — separate from legacy ResearchScore
model EvergreenScore {
  id                     String       @id @default(cuid())
  adId                   String
  // Score components
  totalScore             Float?       // 0–100 or null if INSUFFICIENT_EVIDENCE
  tier                   String       @default("INSUFFICIENT_EVIDENCE") // HIGH_RESEARCH_PRIORITY|MEDIUM_RESEARCH_PRIORITY|LOW_RESEARCH_PRIORITY|INSUFFICIENT_EVIDENCE
  longevityScore         Float?       // Evidence-backed longevity component
  observationScore       Float?       // Observation history quality
  coverageScore          Float?       // Continuity coverage
  sourceReliabilityScore Float?       // Source credibility
  // Evidence metadata
  evidenceConfidence     Float?       // 0.0–1.0 overall confidence
  coverageStatus         String       @default("INSUFFICIENT_EVIDENCE") // HIGH_COVERAGE|MODERATE_COVERAGE|SPARSE_COVERAGE|SINGLE_OBSERVATION|INSUFFICIENT_EVIDENCE
  availableSignals       String?      // JSON array of available evidence signals
  missingSignals         String?      // JSON array of missing evidence signals
  longevityCategory      String?      // NEW_TESTING|EARLY_POTENTIAL|PROMISING|STRONG_CANDIDATE|EVERGREEN_CANDIDATE|LONG_TERM_REFERENCE
  calendarAgeDays        Int?         // Computed from earliest known date to now
  observedActiveDays     Int?         // Days we have positive observation of active status
  observationCoverageDays Int?        // Calendar days spanned by our observation history
  verifiedActiveObservationCount Int? // Count of verified-ACTIVE observations
  scoreBreakdown         String?      // JSON: detailed breakdown with sources
  formulaVersion         String       @default("7.0.0")
  explanation            String?      // Human-readable score explanation
  createdAt              DateTime     @default(now())
  ad                     CompetitorAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
  @@index([totalScore])
  @@map("evergreen_scores")
}

/// Product demand observations imported from authorized sources
model ProductDemandObservation {
  id                   String          @id @default(cuid())
  productId            String
  source               String          // GOOGLE_TRENDS_CSV|USER_MANUAL|PROVIDER_API
  region               String          @default("US")
  keyword              String
  periodStart          DateTime
  periodEnd            DateTime
  demandValue          Float?          // Relative interest 0–100 (Google Trends scale)
  valueType            String          @default("RELATIVE_INTEREST") // RELATIVE_INTEREST|SEARCH_VOLUME_EST|PROVIDER_METRIC
  demandStabilityClass String?         // EVERGREEN_STABLE|SEASONAL_RECURRING|TREND_DRIVEN|DECLINING|INSUFFICIENT_DATA
  observedAt           DateTime        @default(now())
  evidenceReference    String?         // Source file, URL, or method
  methodologyVersion   String          @default("1.0")
  product              ResearchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, periodStart])
  @@index([keyword, region])
  @@map("product_demand_observations")
}

/// Creative variants linked to a product + advertiser
model ProductCreativeVariant {
  id               String          @id @default(cuid())
  adId             String
  productId        String?
  advertiserId     String?
  creativeFormat   String          @default("VIDEO") // VIDEO|IMAGE|CAROUSEL
  creativeAngle    String?         // PROBLEM_SOLUTION|PRODUCT_DEMO|UGC|TESTIMONIAL|COMPARISON|OFFER_LED|EDUCATIONAL|OTHER|UNKNOWN
  firstObservedAt  DateTime        @default(now())
  lastObservedAt   DateTime        @default(now())
  verifiedStatus   String          @default("UNVERIFIED") // VERIFIED|UNVERIFIED|SYNTHETIC
  sourceReference  String?         // Original source URL
  notes            String?
  createdAt        DateTime        @default(now())
  ad               CompetitorAd    @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([productId])
  @@map("product_creative_variants")
}

/// Researcher's manual decision on a product or ad
model ResearchDecision {
  id          String          @id @default(cuid())
  adId        String?
  productId   String?
  decision    String          // RESEARCHING|SHORTLISTED|TEST_CANDIDATE|REJECTED|ARCHIVED
  notes       String?
  decidedAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  ad          CompetitorAd?   @relation(fields: [adId], references: [id], onDelete: Cascade)
  product     ResearchProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("research_decisions")
}

/// V7 Evergreen Product Score (product-level, separate from ad-level)
model EvergreenProductScore {
  id                     String          @id @default(cuid())
  productId              String
  totalScore             Float?
  tier                   String          @default("INSUFFICIENT_EVIDENCE")
  demandStabilityScore   Float?
  adPersistenceScore     Float?
  creativeInvestScore    Float?
  productAvailScore      Float?
  evidenceConfidence     Float?
  demandStabilityClass   String?         // EVERGREEN_STABLE|SEASONAL_RECURRING|TREND_DRIVEN|DECLINING|INSUFFICIENT_DATA
  observationPeriodDays  Int?
  demandObservationCount Int?
  linkedAdCount          Int?
  distinctCreativeCount  Int?
  scoreBreakdown         String?         // JSON
  formulaVersion         String          @default("7.0.0")
  createdAt              DateTime        @default(now())
  product                ResearchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("evergreen_product_scores")
}

// -------------------------------------------------------------
// V9 — Automated Ad Discovery & Provider Ledger Models
// -------------------------------------------------------------

model DiscoverySchedule {
  id                  String         @id @default(cuid())
  workspaceId         String
  name                String         @default("US TikTok Top Ads Discovery")
  enabled             Boolean        @default(false)
  providerId          String         @default("tiktok-topads")
  searchWindowDays    Int            @default(30)
  targetMarket        String         @default("US")
  keywordsJson        String         @default("[\"ecommerce\",\"gadget\",\"beauty\"]")
  industriesJson      String         @default("[]")
  dailyLimit          Int            @default(20)
  timezone            String         @default("UTC")
  hourOfDayUtc        Int            @default(6)
  lastRunAt           DateTime?
  nextEligibleRunAt   DateTime?
  failureCount        Int            @default(0)
  lastErrorReason     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  runs                DiscoveryRun[]

  @@index([workspaceId, enabled])
  @@map("discovery_schedules")
}

model DiscoveryRun {
  id                     String                  @id @default(cuid())
  scheduleId             String?
  workspaceId            String                  @default("default-workspace")
  jobId                  String?
  providerId             String
  status                 String                  @default("PENDING")
  runMode                String                  @default("MANUAL")
  queryConfigJson        String
  cursor                 String?
  requestedLimit         Int                     @default(20)
  actualRetrievedCount   Int                     @default(0)
  validCount             Int                     @default(0)
  newUniqueCount         Int                     @default(0)
  existingDuplicateCount Int                     @default(0)
  rejectedCount          Int                     @default(0)
  failedCount            Int                     @default(0)
  totalRequestCount      Int                     @default(0)
  estimatedCostUsd       Float?
  actualCostUsd          Float?
  creditsUsed            Int                     @default(0)
  errorMessage           String?
  errorCategory          String?
  startedAt              DateTime?
  finishedAt             DateTime?
  heartbeatAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  schedule               DiscoverySchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  requestLedgers         ProviderRequestLedger[]

  @@index([workspaceId, status])
  @@index([providerId, createdAt])
  @@map("discovery_runs")
}

model ProviderRequestLedger {
  id                String        @id @default(cuid())
  providerId        String
  discoveryRunId    String?
  jobId             String?
  requestedAt       DateTime      @default(now())
  providerRequestId String?
  outcome           String
  httpStatus        Int?
  resultCount       Int           @default(0)
  estimatedCost     Float?
  actualCost        Float?
  creditUnit        String        @default("CREDITS")
  errorCategory     String?
  requestDurationMs Int?
  endpointRedacted  String?
  createdAt         DateTime      @default(now())
  discoveryRun      DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  @@index([providerId, requestedAt])
  @@index([discoveryRunId])
  @@map("provider_request_ledgers")
}

model AdSourceIdentity {
  id                 String       @id @default(cuid())
  adId               String
  platform           String
  providerId         String
  sourceExternalId   String?
  stableIdentityHash String       @unique
  canonicalSourceUrl String
  confidence         Float        @default(1.0)
  firstSeenAt        DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  ad                 CompetitorAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([platform, providerId, sourceExternalId])
  @@index([adId])
  @@map("ad_source_identities")
}

