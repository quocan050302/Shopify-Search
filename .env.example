# ════════════════════════════════════════════════════════════════════
# SWAI — Shopify Winning Ads Intelligence
# Environment Configuration Template
#
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ════════════════════════════════════════════════════════════════════

# ── Operating Mode ───────────────────────────────────────────────────
# RESEARCH_ONLY (default): manual + automated competitive research only.
# RESEARCH_AND_STORE: enables optional Shopify store connection.
APP_OPERATING_MODE="RESEARCH_ONLY"
DEFAULT_TARGET_MARKET="US"

# ── Database ─────────────────────────────────────────────────────────
# SQLite for local dev. Replace with libSQL cloud URL for production.
DATABASE_URL="file:./dev.db"

# ── App URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Feature Flags ────────────────────────────────────────────────────
# All disabled by default. Enable only after connecting the relevant account.
ENABLE_SHOPIFY_CONNECTION=false
ENABLE_META_OWNED_ADS=false
ENABLE_TIKTOK_OWNED_ADS=false
ENABLE_STORE_ANALYTICS=false

# ── Discovery Safety ─────────────────────────────────────────────────
# FREE_DISCOVERY_MODE=true (default): blocks all paid outbound API calls.
# Set to false only after explicitly authorizing a paid provider.
FREE_DISCOVERY_MODE=true

# ── TikTok Creative Center Session Cookie (Primary Auto Discovery) ───
# HOW TO OBTAIN:
#   1. Log in to https://ads.tiktok.com/business/creativecenter/inspiration/topads/pc/en
#   2. Open DevTools → Network → filter for "creative_radar_api"
#   3. Copy the full Cookie header value from any request.
#   4. Paste below. The cookie is valid for roughly 7–30 days.
#
# IMPORTANT: This accesses an UNDOCUMENTED internal TikTok endpoint.
#   It is not part of the official TikTok Business API. TikTok may
#   change, block, or deprecate it without notice.
#   Without this cookie, the provider reports NOT_CONFIGURED (not an error —
#   it simply means no probe has been attempted).
TIKTOK_CC_COOKIE=""

# ── Apify Integration (Optional — Paid — Explicitly Disabled) ────────
# Requires BOTH the token AND ENABLE_APIFY_DISCOVERY=true to activate.
# Having APIFY_TOKEN alone does NOT enable paid discovery.
APIFY_TOKEN=""
ENABLE_APIFY_DISCOVERY=false
# Optional: override the default Apify actor
# APIFY_TIKTOK_ACTOR_ID="lagenuina_agency~tiktok-top-ads-scraper"

# ── AI / Gemini (Optional Video Analysis) ────────────────────────────
GEMINI_API_KEY=""

# ── Meta Ad Library (Optional Research) ──────────────────────────────
# NOTE: the Meta ads_archive API does NOT return US commercial ads, so this
# token cannot fulfil US Facebook competitor discovery. Facebook discovery in
# SWAI is done by the Muse external agent below.
META_AD_LIBRARY_ACCESS_TOKEN=""

# ── MetaAdsCollector MCP (Meta / Facebook Ads Discovery) ────────────
# Self-hosted Python MCP server communicating over stdio.
# No paid external scraping APIs, tunnels, or external agent credentials required.
META_COLLECTOR_ENABLED=true
META_COLLECTOR_PYTHON_BIN=""
META_COLLECTOR_DATA_DIR=""
META_COLLECTOR_COUNTRY="US"
META_COLLECTOR_MAX_RESULTS=25
META_COLLECTOR_MAX_REQUESTS=10
META_COLLECTOR_MAX_SECONDS=300
META_COLLECTOR_MAX_CONCURRENCY=1
META_COLLECTOR_LIVE_TEST_ENABLED=false

ADMIN_API_KEY=""

# ── TikTok Organic Video Intelligence (HasData REST API) ─────────────
# Uses HasData REST API: https://api.hasdata.com/scrape/tiktok/search
# Contract: REST POST, 10 credits/search query.
# Account usage/balance endpoint: https://api.hasdata.com/user/me/usage
# Requires valid HasData API key. When absent, reports CREDENTIALS_REQUIRED.
HASDATA_API_KEY=""

# ── Google Ads Transparency Intelligence (MCP Protocol) ─────────────
# Communicates with Google Ads Transparency Center via Model Context Protocol (MCP).
# Native package: gads-transparency-mcp (stdio transport).
# Supported tools: search_advertiser, get_advertiser_ads, get_ad_details.
# Transport: stdio (or Streamable HTTP via GOOGLE_TRANSPARENCY_MCP_URL).
# Authentication: AUTH_NOT_REQUIRED (public transparency center).
GOOGLE_TRANSPARENCY_MCP_COMMAND="npx -y gads-transparency-mcp"
# GOOGLE_TRANSPARENCY_MCP_URL=""

# ── Live Demand Ingestion (SerpApi Google Trends) ───────────────────
# Internal temporal policy engine is always active (ENGINE_READY).
# For live external Google Trends ingestion, provide SerpApi key:
SERPAPI_API_KEY=""

# ── Captapi (Legacy — Disabled by Default) ────────────────────────────
# Captapi is an optional third-party provider. Disabled by default.
# Core research uses free TikTok Creative Center + Meta Ad Library.
CAPTAPI_KEY=""

