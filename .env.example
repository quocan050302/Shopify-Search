# Environment configuration for Shopify Winning Ads Intelligence (SWAI)
# Operating Mode: RESEARCH_ONLY (default) | RESEARCH_AND_STORE | OWNED_AD_ACCOUNT_ANALYTICS
APP_OPERATING_MODE="RESEARCH_ONLY"
DEFAULT_TARGET_MARKET="US"

# Database connection URL (SQLite for local dev & testing, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags (Disabled by default until accounts connected)
ENABLE_SHOPIFY_CONNECTION=false
ENABLE_META_OWNED_ADS=false
ENABLE_TIKTOK_OWNED_ADS=false
ENABLE_STORE_ANALYTICS=false

# Optional external API credentials (empty in RESEARCH_ONLY mode)
META_AD_LIBRARY_ACCESS_TOKEN=""
TIKTOK_COMMERCIAL_API_KEY=""
GEMINI_API_KEY=""
