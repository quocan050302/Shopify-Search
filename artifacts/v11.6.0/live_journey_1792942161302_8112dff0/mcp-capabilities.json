  "proxy_schema": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Name",
        "type": "string"
      },
      "environment": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Environment"
      },
      "secret_file": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Secret File"
      },
      "max_failures": {
        "default": 3,
        "maximum": 100,
        "minimum": 1,
        "title": "Max Failures",
        "type": "integer"
      },
      "cooldown": {
        "default": 300,
        "maximum": 86400,
        "minimum": 0,
        "title": "Cooldown",
        "type": "number"
      }
    },
    "required": [
      "name"
    ],
    "title": "ProxyProfile",
    "type": "object"
