{
  "extension_version": "0.1.0",
  "collector_version": "1.7.0",
  "transport": "stdio",
  "persistent_worker_alive": false,
  "operations": [
    "discover",
    "advertisers",
    "search",
    "continue_search",
    "inspect_ads",
    "results",
    "export_results",
    "jobs",
    "monitoring",
    "proxy"
  ],
  "search_schema": {
    "$defs": {
      "Filters": {
        "additionalProperties": false,
        "properties": {
          "min_impressions": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Impressions"
          },
          "max_impressions": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Impressions"
          },
          "min_spend": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Spend"
          },
          "max_spend": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Spend"
          },
          "start_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "media_type": {
            "anyOf": [
              {
                "enum": [
                  "ALL",
                  "IMAGE",
                  "VIDEO",
                  "MEME",
                  "NONE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Media Type"
          },
          "publisher_platforms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publisher Platforms"
          },
          "languages": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Languages"
          },
          "has_video": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Has Video"
          },
          "has_image": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Has Image"
          },
          "missing_data": {
            "default": "include",
            "enum": [
              "include",
              "exclude"
            ],
            "title": "Missing Data",
            "type": "string"
          }
        },
        "title": "Filters",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "query": {
        "default": "",
        "maxLength": 1000,
        "title": "Query",
        "type": "string"
      },
      "country": {
        "default": "US",
        "title": "Country",
        "type": "string"
      },
      "ad_type": {
        "default": "ALL",
        "title": "Ad Type",
        "type": "string"
      },
      "status": {
        "default": "ACTIVE",
        "title": "Status",
        "type": "string"
      },
      "search_type": {
        "default": "KEYWORD_UNORDERED",
        "title": "Search Type",
        "type": "string"
      },
      "page_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Page Ids"
      },
      "sort_by": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Sort By"
      },
      "filters": {
        "$ref": "#/$defs/Filters"
      },
      "max_results": {
        "default": 100,
        "maximum": 100000,
        "minimum": 1,
        "title": "Max Results",
        "type": "integer"
      },
      "page_size": {
        "default": 20,
        "maximum": 30,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      },
      "max_requests": {
        "default": 100,
        "maximum": 10000,
        "minimum": 1,
        "title": "Max Requests",
        "type": "integer"
      },
      "max_seconds": {
        "default": 600,
        "maximum": 86400,
        "minimum": 1,
        "title": "Max Seconds",
        "type": "integer"
      },
      "proxy_profile": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Proxy Profile"
      },
      "timeout": {
        "default": 30,
        "maximum": 120,
        "minimum": 1,
        "title": "Timeout",
        "type": "integer"
      },
      "max_retries": {
        "default": 3,
        "maximum": 5,
        "minimum": 1,
        "title": "Max Retries",
        "type": "integer"
      },
      "rate_limit_delay": {
        "default": 1,
        "maximum": 60,
        "minimum": 0,
        "title": "Rate Limit Delay",
        "type": "number"
      },
      "jitter": {
        "default": 0.5,
        "maximum": 10,
        "minimum": 0,
        "title": "Jitter",
        "type": "number"
      },
      "cookie_env": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cookie Env"
      }
    },
    "title": "Search",
    "type": "object"
  },
